#include <stdio.h>

int main() {

    int t;

    scanf("%d",&t);

    while(t--)

    {

        int n;

        scanf("%d",&n);

        int a[n];

        for(int i=0;i<n;i++)

        {

            scanf("%d\n",&a[i]);

        }

        int h;

        h=a[0];

        for(int i=0;i<n;i++)

        {

            if(h<a[i])

            {

                h=a[i];

            }

        }

        printf("%d\n",h);

    }

}

